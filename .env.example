# Copy this file to .env and replace the empty values locally.
# Never commit the .env file or share the client secret.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/login/google/callback/

# Optional: set this only when using a Google Workspace domain.
# GOOGLE_OAUTH_ALLOWED_DOMAIN=jmcfi.edu.ph
